{
  "name": "typescript-hub",
  "version": "1.0.0",
  "description": "Academia prática e enciclopédia definitiva de TypeScript, Clean Architecture e SOLID: do Zero Absoluto à Arquitetura de Software Profissional.",
  "type": "module",
  "author": "Christopher Marques <https://github.com/ChristopherMarques>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:docs": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "play:basics": "tsx 01-fundamentals/playground/01-primitives-and-unions.ts",
    "play:generics": "tsx 01-fundamentals/playground/02-generics-in-practice.ts",
    "play:unions": "tsx 01-fundamentals/playground/03-discriminated-unions.ts",
    "play:solid:violations": "tsx 03-architecture-and-solid/examples/01-solid-violations.ts",
    "play:solid": "tsx 03-architecture-and-solid/examples/02-solid-and-clean-arch-refactored.ts",
    "start:project": "tsx 05-hands-on-project/src/main.ts",
    "test:all": "npm run typecheck && npm run play:basics && npm run play:generics && npm run play:unions && npm run play:solid && npm run start:project"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "typescript",
    "clean-architecture",
    "solid",
    "domain-driven-design",
    "software-engineering",
    "design-patterns",
    "generics",
    "best-practices"
  ],
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.69.0",
    "marked": "^18.1.3",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.6"
  }
}
